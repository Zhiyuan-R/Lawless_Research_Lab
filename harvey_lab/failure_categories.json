 "labels": [
  {
   "key": "missed",
   "short": "漏点",
   "label": "漏掉了某个具体问题或分析角度",
   "desc": "相关领域分析了，但专家期望的某一个具体点没写到。例如没把 MTCA 三倍赔偿和合同的“倍数损害”排除条款联系起来，没分析新加坡的军事最终用途规则，没提到被诉人承认审查过对方代码库。这类最多，说明问题不在“不会”，而在“没想全”。"
  },
  {
   "key": "quant",
   "short": "没量化",
   "label": "该算的数没算，或没给市场基准",
   "desc": "指出了问题，但没有给出专家期望的金额估算或市场参照：例如医疗任务没估算 $2.61M 影像收入风险和约 $30M 总敞口，房地产任务没写陈述保证存续期的市场区间（6–12 个月），破产任务漏了 KERP 没收后的 $1.77M。资深律师会主动把风险换算成数字。"
  },
  {
   "key": "position",
   "short": "立场",
   "label": "立场或建议与专家预期不同",
   "desc": "agent 做了判断，但和评分标准预设的立场不一样。最典型的是合同修订任务：标准要求坚决拒绝对方的“优先权”和马里兰管辖，agent 选择了有条件让步。这类往往取决于委托人的谈判策略，而案卷里没给 playbook。"
  },
  {
   "key": "severity",
   "short": "轻重",
   "label": "轻重判断与专家不同",
   "desc": "把干扰项当成高风险（并购任务的怀俄明许可证），把小差异评成 High（10-Q 的股数差异），或把实质问题标成“符合”（风电租约的受让人门槛）。这正对应初级和资深律师之间最难教的“重要性判断”。"
  },
  {
   "key": "format",
   "short": "格式",
   "label": "结构或格式要求没满足",
   "desc": "缺少专家要求的固定部分：“已排除事项”清单（两个任务都漏了）、HIPAA/GDPR 对照表、投资委员会会议的语境、正确的落款日期。容易补，但 all-pass 规则下同样致命。"
  },
  {
   "key": "disputed",
   "short": "可商榷",
   "label": "疑似评分标准本身可商榷",
   "desc": "agent 给出了有理有据的不同结论，而且很可能是对的或至少站得住。见下方“值得留意的几件事”。这类失分不一定代表能力不足。"
  }
 ],
